# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — see docs/SUPABASE_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the access-code cookie (lib/auth/access-cookie.ts). Generate with:
# openssl rand -base64 32
ACCESS_COOKIE_SECRET=

# Comma-separated list of emails allowed into /admin. Must also exist in the
# admin_users table (see docs/SUPABASE_SETUP.md) — both checks must pass.
ADMIN_EMAIL_ALLOWLIST=gabrielgerhard10@gmail.com

# Mercado Pago — see docs/PAYMENTS.md
# Use "test" during homologation and change to "production" only together
# with the production Access Token. Webhooks reject cross-environment payments.
MERCADOPAGO_ENV=test
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Fallback Pix key shown if online payment isn't configured yet (not wired
# into the UI in V1 — kept here as the placeholder the brief asked for).
PIX_KEY_FALLBACK=49988148811
